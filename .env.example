# ── AI Video Assistant Environment Variables ──
# Copy this file to .env and fill in your real API keys.

# Required: Mistral API Key for LLM summarization, extraction, and RAG.
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Sarvam AI API Key (only needed for Hinglish / Hindi transcription).
# Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# Optional: Local Whisper model size (tiny / base / small / medium / large).
# Smaller = faster but less accurate. Default is small.
WHISPER_MODEL=small
